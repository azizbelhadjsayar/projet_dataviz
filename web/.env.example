# Copier ce fichier en .env.local et renseigner les valeurs.

# ── Agent d'analyse IA : chaîne d'accès ───────────────────────
# Ordre utilisé : Gemini 3.8 → Gemini 3.7 → Groq (toutes les clés, à tour de rôle) → Gemini Lite → Groq (modèle 2)
# Un accès qui atteint son quota (429) est mis en pause le temps indiqué par le fournisseur.

# Principal — clé gratuite Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secours — une ou plusieurs clés Groq (https://console.groq.com/keys), séparées par des virgules
GROQ_API_KEYS=

# Optionnel : modèles
# LLM_MODEL=gemini-3.8-flash
# LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# Optionnel : effort de raisonnement de l'agent Gemini (minimal | low | medium | high)
# LLM_REASONING_EFFORT=low

# Alternative : un seul fournisseur compatible OpenAI (remplace la chaîne ci-dessus)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# ── Power BI (plus tard) ──────────────────────────────────────
# URL d'incorporation (Fichier > Incorporer le rapport > Publier sur le web)
# POWERBI_EMBED_URL=https://app.powerbi.com/view?r=...
